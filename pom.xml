<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.monkno</groupId>
  <artifactId>nileslabs-graphql</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <gatling.version>3.16.0</gatling.version>
    <kotlin.version>2.4.20</kotlin.version>
    <maven.compiler.release>21</maven.compiler.release>
    <gatling.simulationClass>performance.GraphQLSimulation</gatling.simulationClass>
    <gatling.resultsFolder>${project.build.directory}/gatling</gatling.resultsFolder>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-stdlib</artifactId><version>${kotlin.version}</version>
    </dependency>
    <dependency>
      <groupId>io.gatling.highcharts</groupId><artifactId>gatling-charts-highcharts</artifactId><version>${gatling.version}</version><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.gatling</groupId><artifactId>gatling-graphql-java</artifactId><version>3.16.0.1</version><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.graphql-java</groupId><artifactId>graphql-java</artifactId><version>25.0</version><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>2.20.1</version><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.13.4</version><scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-maven-plugin</artifactId><version>${kotlin.version}</version>
        <configuration><jvmTarget>21</jvmTarget></configuration>
        <executions>
          <execution><id>test-compile</id><goals><goal>test-compile</goal></goals></execution>
        </executions>
      </plugin>
      <plugin><artifactId>maven-compiler-plugin</artifactId><version>3.16.0</version></plugin>
      <plugin><artifactId>maven-resources-plugin</artifactId><version>3.5.0</version></plugin>
      <plugin><artifactId>maven-surefire-plugin</artifactId><version>3.5.4</version></plugin>
      <plugin>
        <groupId>io.gatling</groupId><artifactId>gatling-maven-plugin</artifactId><version>4.21.12</version>
        <configuration>
          <simulationClass>${gatling.simulationClass}</simulationClass>
          <resultsFolder>${gatling.resultsFolder}</resultsFolder>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
